#!/usr/bin/env xdg-open
# vim:ft=desktop
[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
Name={{ zoidy_panelsweet_vim_launcher_name }}
Name[en_US]={{ zoidy_panelsweet_vim_launcher_name }}
Exec={{ ansible_env.HOME }}/.local/bin/bash -c "{{ ansible_env.HOME }}/.kit/sh/gvim-open-kindness/bin/gvim-open-kindness '' '' '' {{ zoidy_matecocido_dubs_vim_edit }} && wmctrl -b add,sticky -r {{ zoidy_matecocido_dubs_vim_servername }}"
Icon={{ zoidy_matecocido_dubs_vim_icon }}
Icon[en_US]={{ zoidy_matecocido_dubs_vim_icon }}
